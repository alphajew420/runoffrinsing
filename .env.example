# --- Required for Payload CMS ---

# Postgres connection string. Get one from Railway, Neon, Supabase, etc.
DATABASE_URL=postgres://user:password@host:5432/runoffrinsing

# Random 32+ character string. Used to sign admin sessions.
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Public URL of the deployed site. Used by Payload for admin links.
NEXT_PUBLIC_SERVER_URL=https://runoffrinsing.com

# --- Optional: S3-compatible object storage for uploaded images ---
# Without these, image uploads fall back to local disk (won't persist on Railway).
# Recommended providers: Cloudflare R2, Backblaze B2, AWS S3.

S3_BUCKET=runoffrinsing-media
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public hostname where the bucket is served (e.g. a CDN domain).
S3_CDN_HOST=cdn.runoffrinsing.com

# --- Optional: first-time admin login (only used by the seed script) ---
SEED_ADMIN_EMAIL=admin@runoffrinsing.com
SEED_ADMIN_PASSWORD=ChangeMe123!
